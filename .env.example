# ---------- Gemini (server-side only; never prefix with NEXT_PUBLIC_) ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Hard cap on Gemini requests per UTC day, enforced atomically in the database (cache hits are free)
GEMINI_DAILY_LIMIT=20
GEMINI_MAX_INPUT_TOKENS=6000
GEMINI_MAX_OUTPUT_TOKENS=1500
GEMINI_TIMEOUT_MS=15000
# Chunks per Gemini request (clamped 10-15) and max batches per document (clamped 1-10)
GEMINI_BATCH_CHUNKS=12
GEMINI_MAX_BATCHES=10
# Stop starting new Gemini requests after this long (serverless time limit). Re-scanning resumes from cache.
SCAN_TIME_BUDGET_MS=40000
# A finding at/above this confidence (and high/critical severity) is a confirmed threat -> early stop
CONFIRM_THRESHOLD=0.85

# ---------- Documents ----------
# Vercel rejects request bodies > 4.5 MB, so the value is capped at 4 on Vercel.
MAX_UPLOAD_MB=4
CHUNK_WORDS=180
CHUNK_OVERLAP_WORDS=30

# ---------- Policy gateway ----------
INTERNAL_EMAIL_DOMAIN=northwind.example
# External email stays blocked unless explicitly "true" (emails are always simulated anyway)
ALLOW_EXTERNAL_EMAIL=false

# ---------- Storage (MongoDB) ----------
# Local development: leave MONGODB_URI empty to use a mongod on mongodb://127.0.0.1:27017
# Production (Vercel): a MongoDB Atlas connection string. Required for the app to work there.
MONGODB_URI=
MONGODB_DB=incheck

# ---------- Access control (recommended for any public deployment) ----------
# When both are set the whole app (pages + API, except /api/health) requires HTTP Basic auth.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
# Set to "true" to disable the per-IP rate limits (useful for load tests only)
RATE_LIMIT_DISABLED=false
